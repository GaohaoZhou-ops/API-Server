{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API Docs v1 public document manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "visibility", "revision", "productVersion", "publishedAt", "site", "guides"],
  "properties": {
    "protocol": {"const": "api-docs/v1"},
    "visibility": {"const": "public"},
    "revision": {"type": "string", "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$", "not": {"pattern": "\\.\\."}},
    "productVersion": {"type": "string", "minLength": 1, "maxLength": 64},
    "publishedAt": {"type": "string", "format": "date-time"},
    "site": {
      "type": "object", "additionalProperties": false, "required": ["name", "title", "description"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "description": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "guides": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "title", "group", "file"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$", "not": {"enum": ["overview", "reference", "catalog", "models", "changelog", "feedback", "admin", "compare"]}},
          "title": {"type": "string", "minLength": 1, "maxLength": 120},
          "description": {"type": "string", "minLength": 1, "maxLength": 1000},
          "group": {"type": "string", "minLength": 1, "maxLength": 80},
          "file": {"type": "string", "pattern": "^guides/[A-Za-z0-9][A-Za-z0-9_-]*\\.md$"}
        }
      }
    },
    "openapi": {"const": "openapi.json"},
    "changes": {
      "type": "object", "additionalProperties": false, "required": ["title"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "added": {"$ref": "#/$defs/changeList"},
        "changed": {"$ref": "#/$defs/changeList"},
        "compatibility": {"$ref": "#/$defs/changeList"},
        "validation": {"$ref": "#/$defs/changeList"}
      }
    }
  },
  "anyOf": [{"required": ["openapi"]}, {"properties": {"guides": {"minItems": 1}}}],
  "$defs": {"changeList": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 2000}}}
}
